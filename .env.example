# Identificador público compartilhado; não é um segredo.
PUBLIC_GOOGLE_CLIENT_ID=
# Controle global opcional. Não coloque valores destas variáveis no frontend.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BANK_ASSIGNMENT_SECRET=
BANK_ADMIN_EMAILS=
# Na ativação, capture TODOS os IDs já publicados; não retire IDs desta lista.
BANK_PROTECTED_IDS=
# Exceção por lei, somente após confirmação expressa de ausência de estudos antigos.
# Não libera bancos com atribuições registradas e não remove IDs do baseline.
BANK_REVIEWED_UNUSED_IDS=
# Token fino: somente evertoncmartins/foco-concurso, Contents: Read and write.
BANK_GITHUB_TOKEN=
# Nunca adicione access tokens ou client secrets ao frontend.
