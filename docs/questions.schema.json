{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foco-concurso-wine.vercel.app/docs/questions.schema.json",
  "title": "Foco — Banco de questões v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "shortText": {
      "type": "string",
      "minLength": 1
    },
    "longText": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "discipline",
        "subject",
        "topic",
        "statement",
        "options",
        "correctOption",
        "explanation",
        "difficulty",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "minLength": 1,
          "maxLength": 120
        },
        "discipline": {
          "$ref": "#/$defs/shortText"
        },
        "subject": {
          "$ref": "#/$defs/shortText"
        },
        "topic": {
          "$ref": "#/$defs/shortText"
        },
        "statement": {
          "$ref": "#/$defs/longText"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-H]$"
              },
              "text": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/longText"
                  },
                  {
                    "type": "number"
                  }
                ],
                "description": "Texto não vazio sem limite de caracteres. Números são aceitos na importação e normalizados para texto."
              }
            }
          }
        },
        "correctOption": {
          "type": "string",
          "pattern": "^[A-H]$"
        },
        "explanation": {
          "$ref": "#/$defs/longText"
        },
        "reference": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string"
          }
        },
        "instituicao": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "banca": {
          "type": "string",
          "minLength": 1
        },
        "cargo": {
          "type": "string",
          "minLength": 1
        },
        "nivelCargo": {
          "type": "string",
          "minLength": 1
        },
        "tipo": {
          "type": "string",
          "minLength": 1
        },
        "fundamentoLegal": {
          "type": "string",
          "minLength": 1
        },
        "atualizacaoLegislativa": {
          "type": "string",
          "minLength": 1
        },
        "ano": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "fonte": {
          "type": "object",
          "properties": {
            "prova": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "gabarito": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "editalUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "questaoOriginal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "paginaProva": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "dataProva": {
              "type": "string",
              "format": "date"
            },
            "consultaEm": {
              "type": "string",
              "format": "date"
            },
            "edital": {
              "type": "string",
              "minLength": 1
            },
            "statusGabarito": {
              "type": "string",
              "minLength": 1
            },
            "gabaritoOriginal": {
              "type": "string",
              "pattern": "^[A-H]$"
            },
            "editalDocumento": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "paginaGabarito": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "observacao": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "optionExplanations": {
          "type": "object",
          "description": "Justificativa individual por ID de alternativa. Opcional no pessoal; obrigatório no nativo. Se presente, precisa cobrir exatamente as opções existentes (regra complementada pelo importador).",
          "minProperties": 2,
          "maxProperties": 8,
          "patternProperties": {
            "^[A-H]$": {
              "$ref": "#/$defs/longText"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "nativeQuestion": {
      "allOf": [
        {
          "$ref": "#/$defs/question"
        },
        {
          "required": [
            "optionExplanations",
            "fundamentoLegal",
            "reference",
            "tipo"
          ],
          "properties": {
            "reference": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://[^/@:]+\\.(gov|leg|jus)\\.br(?:/|$)"
                }
              }
            }
          }
        }
      ]
    },
    "nativeBank": {
      "description": "Mesmo formato com o perfil editorial obrigatório dos bancos em public/data/question-banks/. Unicidade e correspondência dos IDs são conferidas pelo código.",
      "allOf": [
        {
          "$ref": "#"
        },
        {
          "properties": {
            "questions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nativeQuestion"
              }
            }
          }
        }
      ]
    }
  },
  "description": "Padrão único schemaVersion 1. Perfil pessoal compatível; perfil nativo em #/$defs/nativeBank com feedback completo obrigatório."
}
