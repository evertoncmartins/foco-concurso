{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foco-concursos.example/schemas/questions-v1.json",
  "title": "Foco — Banco de questões v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "discipline",
        "subject",
        "topic",
        "statement",
        "options",
        "correctOption",
        "explanation",
        "difficulty",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "minLength": 1,
          "maxLength": 120
        },
        "discipline": {
          "$ref": "#/$defs/shortText"
        },
        "subject": {
          "$ref": "#/$defs/shortText"
        },
        "topic": {
          "$ref": "#/$defs/shortText"
        },
        "statement": {
          "$ref": "#/$defs/longText"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-H]$"
              },
              "text": {
                "$ref": "#/$defs/longText"
              }
            }
          }
        },
        "correctOption": {
          "type": "string",
          "pattern": "^[A-H]$"
        },
        "explanation": {
          "$ref": "#/$defs/longText"
        },
        "reference": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "instituicao": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "banca": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cargo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "nivelCargo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tipo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fundamentoLegal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "atualizacaoLegislativa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "ano": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "fonte": {
          "type": "object",
          "properties": {
            "prova": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 3000
            },
            "gabarito": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 3000
            },
            "editalUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 3000
            },
            "questaoOriginal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "paginaProva": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "dataProva": {
              "type": "string",
              "format": "date"
            },
            "consultaEm": {
              "type": "string",
              "format": "date"
            },
            "edital": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "statusGabarito": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "gabaritoOriginal": {
              "type": "string",
              "pattern": "^[A-H]$"
            },
            "editalDocumento": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 3000
            },
            "paginaGabarito": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "observacao": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    }
  }
}
